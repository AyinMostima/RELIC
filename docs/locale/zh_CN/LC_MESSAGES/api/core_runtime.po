msgstr "`conservation_tolerance`"

#: <RELIC_ROOT>/docs/source/public/api/core_runtime.md
msgid "unset (`validation.conservation.conservation_tolerance`)"
msgstr "未设置（`validation.conservation.conservation_tolerance`）"

