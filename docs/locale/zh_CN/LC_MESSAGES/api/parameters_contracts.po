msgid "`delta_storage`"
msgstr "`delta_storage`"

#: <RELIC_ROOT>/docs/source/public/api/parameters_contracts.md:10
msgid "Observed storage change."
msgstr "观测到的 storage change。"

#: <RELIC_ROOT>/docs/source/public/api/parameters_contracts.md:10
msgid "`residual`"
msgstr "`residual`"

#: <RELIC_ROOT>/docs/source/public/api/parameters_contracts.md:10
msgid "Absolute difference between observed and expected storage change."
msgstr "观测 storage change 与预期 storage change 之间的 absolute difference。"

#: <RELIC_ROOT>/docs/source/public/api/parameters_contracts.md:10
msgid "`passed`"
msgstr "`passed`"

#: <RELIC_ROOT>/docs/source/public/api/parameters_contracts.md:10
msgid "Whether the residual is within tolerance."
msgstr "Residual 是否在 tolerance 内。"

#: <RELIC_ROOT>/docs/source/public/api/parameters_contracts.md:10
msgid "`tolerance_used`"
msgstr "`tolerance_used`"

#: <RELIC_ROOT>/docs/source/public/api/parameters_contracts.md:10
msgid "Computed absolute-plus-relative threshold."
msgstr "计算得到的 absolute-plus-relative threshold。"

#: <RELIC_ROOT>/docs/source/public/api/parameters_contracts.md:10
msgid "`invariant_drift`"
msgstr "`invariant_drift`"

#: <RELIC_ROOT>/docs/source/public/api/parameters_contracts.md:10
msgid "Optional separately computed Noether invariant drift."
msgstr "可选的独立计算 Noether invariant drift。"

#: <RELIC_ROOT>/docs/source/public/api/parameters_contracts.md:1099
msgid "The dataclass performs no constructor-time validation. It is a domain result owned by the guardian and must not be confused with `relic.validation.framework.ValidationResultModel`."
msgstr "该 dataclass 不执行 constructor-time validation。它是 guardian-owned domain result，不得与 `relic.validation.framework.ValidationResultModel` 混淆。"

