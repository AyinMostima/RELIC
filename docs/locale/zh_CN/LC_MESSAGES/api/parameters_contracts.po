msgstr "`default_atol`"

#: <RELIC_ROOT>/docs/source/public/api/parameters_contracts.md:10
msgid "Default absolute residual tolerance."
msgstr "默认 absolute residual tolerance。"

#: <RELIC_ROOT>/docs/source/public/api/parameters_contracts.md:10
