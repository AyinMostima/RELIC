"\\mathrm{GraphIR}\n"
"\\xrightarrow{\\mathrm{validate\\_graph}}\n"
"\\mathrm{ValidationReport}\n"
"\\xrightarrow{\\mathrm{compile\\_graph}}\n"
"\\mathrm{ExecutionPlan}.\n"
msgstr ""
"\n"
"\\mathrm{GraphIR}\n"
"\\xrightarrow{\\mathrm{validate\\_graph}}\n"
"\\mathrm{ValidationReport}\n"
"\\xrightarrow{\\mathrm{compile\\_graph}}\n"
"\\mathrm{ExecutionPlan}.\n"

