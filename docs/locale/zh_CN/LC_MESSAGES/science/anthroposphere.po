msgstr "`anthroposphere.land_use.soil.water.soil_porosity`"

#: <RELIC_ROOT>/docs/source/public/science/anthroposphere.md:571
msgid "No soil over water. Porosity is a volume fraction of the soil and lies in [0, 1]."
msgstr "水面无土壤。孔隙度为土壤体积分数，位于 [0, 1]。"

#: <RELIC_ROOT>/docs/source/public/science/anthroposphere.md:571
