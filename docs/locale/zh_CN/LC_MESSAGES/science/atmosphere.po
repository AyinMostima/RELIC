#: <RELIC_ROOT>/docs/source/public/science/atmosphere.md:92
msgid "$\\frac{\\mathrm{d}\\left[\\mathrm{NO}\\right]}{\\mathrm{d}t} = J_{\\mathrm{NO2}} \\cdot [ \\mathrm{NO}_{2} ] - k_{\\mathrm{NO},\\mathrm{O3}} \\cdot [ \\mathrm{NO} ] \\cdot [ \\mathrm{O}_{3} ]$; $\\frac{\\mathrm{d}\\left[\\mathrm{NO}_{2}\\right]}{\\mathrm{d}t} = k_{\\mathrm{NO},\\mathrm{O3}} \\cdot [ \\mathrm{NO} ] \\cdot [ \\mathrm{O}_{3} ] - J_{\\mathrm{NO2}} \\cdot [ \\mathrm{NO}_{2} ]$; $\\frac{\\mathrm{d}\\left[\\mathrm{O}_{3}\\right]}{\\mathrm{d}t} = J_{\\mathrm{NO2}} \\cdot [ \\mathrm{NO}_{2} ] - k_{\\mathrm{NO},\\mathrm{O3}} \\cdot [ \\mathrm{NO} ] \\cdot [ \\mathrm{O}_{3} ]$; $k ( T ) = k_{\\mathrm{298}} \\cdot \\exp ( \\mathrm{Ea} / R \\cdot ( 1 / T_{\\mathrm{ref}} - 1 / T ) )$, $T_{\\mathrm{ref}} = 298.15 K$; $J_{\\mathrm{NO2}} = ( 1 + \\alpha ) \\cdot ( \\mathrm{B}_{1} \\cdot G + \\mathrm{B}_{2} \\cdot G ^ 2 ) \\cdot R_{\\mathrm{NO2}} ( T , \\theta )$, $G = \\mathrm{SW} \\mathrm{held}$ at $G_{v} = \\mathrm{B}_{1} / ( 2 \\lvert \\mathrm{B}_{2} \\rvert ) \\mathrm{above} ( \\mathrm{Trebs} \\mathrm{et} \\mathrm{al} . 2009 )$; $J_{\\mathrm{O1D}} = ( 1 + \\alpha ) \\cdot ( \\mathrm{B}_{1} \\cdot G + \\mathrm{B}_{2} \\cdot G ^ 2 ) \\cdot \\rho ( \\theta ) \\cdot R_{\\mathrm{O1D}} ( T , \\theta )$, $\\rho = ( \\mathrm{l1} / \\mathrm{l4} ) \\cos ( \\theta ) ^ ( \\mathrm{m1} - \\mathrm{m4} ) \\exp ( - ( \\mathrm{n1} - \\mathrm{n4} ) / \\cos ( \\theta ) )$; $R_{X} = 1 ( \\mathrm{mode} \\mathrm{none} )$ or sum sigma_X phi_X F0 exp(-tau/cos(theta)) / same at $T_{\\mathrm{ref}}$ (mode spectral_quantum_yield); [OH] = y f $J_{\\mathrm{O1D}}$ [O3] / (k_OH_CO[CO] + k_OH_CH4[CH4] + k_OH_NO2[NO2] + k_OH_C5H8[C5H8]), $f = k_{\\mathrm{H2O}} [ \\mathrm{H2O} ] / ( k_{\\mathrm{H2O}} [ \\mathrm{H2O} ] + k_{\\mathrm{N2}} [ \\mathrm{N}_{2} ] + k_{\\mathrm{O2}} [ \\mathrm{O}_{2} ] )$; $\\mathrm{BVOC} + \\mathrm{OH} \\rightarrow \\mathrm{products} ( k_{\\mathrm{BVOC},\\mathrm{OH}} )$"
msgstr "$\\frac{\\mathrm{d}\\left[\\mathrm{NO}\\right]}{\\mathrm{d}t} = J_{\\mathrm{NO2}} \\cdot [ \\mathrm{NO}_{2} ] - k_{\\mathrm{NO},\\mathrm{O3}} \\cdot [ \\mathrm{NO} ] \\cdot [ \\mathrm{O}_{3} ]$; $\\frac{\\mathrm{d}\\left[\\mathrm{NO}_{2}\\right]}{\\mathrm{d}t} = k_{\\mathrm{NO},\\mathrm{O3}} \\cdot [ \\mathrm{NO} ] \\cdot [ \\mathrm{O}_{3} ] - J_{\\mathrm{NO2}} \\cdot [ \\mathrm{NO}_{2} ]$; $\\frac{\\mathrm{d}\\left[\\mathrm{O}_{3}\\right]}{\\mathrm{d}t} = J_{\\mathrm{NO2}} \\cdot [ \\mathrm{NO}_{2} ] - k_{\\mathrm{NO},\\mathrm{O3}} \\cdot [ \\mathrm{NO} ] \\cdot [ \\mathrm{O}_{3} ]$; $k ( T ) = k_{\\mathrm{298}} \\cdot \\exp ( \\mathrm{Ea} / R \\cdot ( 1 / T_{\\mathrm{ref}} - 1 / T ) )$, $T_{\\mathrm{ref}} = 298.15 K$; $J_{\\mathrm{NO2}} = ( 1 + \\alpha ) \\cdot ( \\mathrm{B}_{1} \\cdot G + \\mathrm{B}_{2} \\cdot G ^ 2 ) \\cdot R_{\\mathrm{NO2}} ( T , \\theta )$, $G = \\mathrm{SW} \\mathrm{held}$ 达到 $G_{v} = \\mathrm{B}_{1} / ( 2 \\lvert \\mathrm{B}_{2} \\rvert ) \\mathrm{above} ( \\mathrm{Trebs} \\mathrm{et} \\mathrm{al} . 2009 )$; $J_{\\mathrm{O1D}} = ( 1 + \\alpha ) \\cdot ( \\mathrm{B}_{1} \\cdot G + \\mathrm{B}_{2} \\cdot G ^ 2 ) \\cdot \\rho ( \\theta ) \\cdot R_{\\mathrm{O1D}} ( T , \\theta )$, $\\rho = ( \\mathrm{l1} / \\mathrm{l4} ) \\cos ( \\theta ) ^ ( \\mathrm{m1} - \\mathrm{m4} ) \\exp ( - ( \\mathrm{n1} - \\mathrm{n4} ) / \\cos ( \\theta ) )$; $R_{X} = 1 ( \\mathrm{mode} \\mathrm{none} )$ 或采用求和式 sigma_X phi_X F0 exp(-tau/cos(theta)) / 同一求和式在 $T_{\\mathrm{ref}}$ 处的值（spectral_quantum_yield 模式）; [OH] = y f $J_{\\mathrm{O1D}}$ [O3] / (k_OH_CO[CO] + k_OH_CH4[CH4] + k_OH_NO2[NO2] + k_OH_C5H8[C5H8]), $f = k_{\\mathrm{H2O}} [ \\mathrm{H2O} ] / ( k_{\\mathrm{H2O}} [ \\mathrm{H2O} ] + k_{\\mathrm{N2}} [ \\mathrm{N}_{2} ] + k_{\\mathrm{O2}} [ \\mathrm{O}_{2} ] )$; $\\mathrm{BVOC} + \\mathrm{OH} \\rightarrow \\mathrm{products} ( k_{\\mathrm{BVOC},\\mathrm{OH}} )$"

