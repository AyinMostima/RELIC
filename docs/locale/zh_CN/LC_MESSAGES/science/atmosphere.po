#, python-brace-format
msgid ""
"\n"
"f_m = \\ln ( ( z - d ) / \\mathrm{z0m} ) - \\psi_m ( ( z - d ) / L ) + \\psi_m ( \\mathrm{z0m} / L ); f_h = \\ln ( ( z - d ) / \\mathrm{z0h} ) - \\psi_h ( ( z - d ) / L ) + \\psi_h ( \\mathrm{z0h} / L ); u_* = k \\cdot U / f_m; \\theta_* = k \\cdot ( \\mathrm{Ts} - \\mathrm{Ta} ) / f_h; H = \\rho \\cdot \\mathrm{cp} \\cdot u_* \\theta_*; L = - \\rho \\cdot \\mathrm{cp} \\cdot T \\cdot u_* ^ 3 / ( k \\cdot g \\cdot H ); r_{ah} = f_h / ( k \\cdot u_* ); \\tau = \\rho \\cdot u_* ^ 2; \\rho = ( p - ( 1 - \\varepsilon ) \\cdot \\mathrm{RH} \\cdot e_{s} ( \\mathrm{Ta} ) ) / ( R_{d} \\cdot \\mathrm{Ta} )\n"
msgstr ""
"\n"
"f_m = \\ln ( ( z - d ) / \\mathrm{z0m} ) - \\psi_m ( ( z - d ) / L ) + \\psi_m ( \\mathrm{z0m} / L ); f_h = \\ln ( ( z - d ) / \\mathrm{z0h} ) - \\psi_h ( ( z - d ) / L ) + \\psi_h ( \\mathrm{z0h} / L ); u_* = k \\cdot U / f_m; \\theta_* = k \\cdot ( \\mathrm{Ts} - \\mathrm{Ta} ) / f_h; H = \\rho \\cdot \\mathrm{cp} \\cdot u_* \\theta_*; L = - \\rho \\cdot \\mathrm{cp} \\cdot T \\cdot u_* ^ 3 / ( k \\cdot g \\cdot H ); r_{ah} = f_h / ( k \\cdot u_* ); \\tau = \\rho \\cdot u_* ^ 2; \\rho = ( p - ( 1 - \\varepsilon ) \\cdot \\mathrm{RH} \\cdot e_{s} ( \\mathrm{Ta} ) ) / ( R_{d} \\cdot \\mathrm{Ta} )\n"

#: <RELIC_ROOT>/docs/source/public/science/atmosphere.md:1647
msgid ""
"\n"
"\\dot{x} = - D_{h} q_{h} + G_{h} u_{h}, q_{h} = - \\star_{\\tau} D_{h} ^{\\mathsf{T}} e_{h}, y_{h} = G_{h} ^{\\mathsf{T}} e_{h}\n"
msgstr ""
"\n"
"\\dot{x} = - D_{h} q_{h} + G_{h} u_{h}, q_{h} = - \\star_{\\tau} D_{h} ^{\\mathsf{T}} e_{h}, y_{h} = G_{h} ^{\\mathsf{T}} e_{h}\n"

