#: <RELIC_ROOT>/docs/source/public/science/biosphere.md:286
msgid ""
"\n"
"\\mathrm{DMAPP} \\xrightarrow{\\mathrm{IS}} \\mathrm{Isoprene}\n"
msgstr ""
"\n"
"\\mathrm{DMAPP} \\xrightarrow{\\mathrm{IS}} \\mathrm{Isoprene}\n"

#: <RELIC_ROOT>/docs/source/public/science/biosphere.md:290
msgid ""
"\n"
"J_{\\mathrm{DXS}} = V_{\\mathrm{max},\\mathrm{DXS}} \\cdot [ \\mathrm{G3P} ] \\cdot [ \\mathrm{Pyr} ] / ( ( K_{\\mathrm{G3P}} + [ \\mathrm{G3P} ] ) \\cdot ( K_{\\mathrm{Pyr}} + [ \\mathrm{Pyr} ] ) )\n"
msgstr ""
"\n"
"J_{\\mathrm{DXS}} = V_{\\mathrm{max},\\mathrm{DXS}} \\cdot [ \\mathrm{G3P} ] \\cdot [ \\mathrm{Pyr} ] / ( ( K_{\\mathrm{G3P}} + [ \\mathrm{G3P} ] ) \\cdot ( K_{\\mathrm{Pyr}} + [ \\mathrm{Pyr} ] ) )\n"

#: <RELIC_ROOT>/docs/source/public/science/biosphere.md:294
msgid ""
"\n"
"J_{\\mathrm{IS}} ( T_{\\mathrm{air}} ) = V_{\\mathrm{max},\\mathrm{IS}} ( T_{\\mathrm{air}} ) \\cdot [ \\mathrm{DMAPP} ] / ( K_{\\mathrm{DMAPP}} + [ \\mathrm{DMAPP} ] ) \\cdot K_{\\mathrm{CO2}} / ( K_{\\mathrm{CO2}} + C_{a} )\n"
msgstr ""
"\n"
"J_{\\mathrm{IS}} ( T_{\\mathrm{air}} ) = V_{\\mathrm{max},\\mathrm{IS}} ( T_{\\mathrm{air}} ) \\cdot [ \\mathrm{DMAPP} ] / ( K_{\\mathrm{DMAPP}} + [ \\mathrm{DMAPP} ] ) \\cdot K_{\\mathrm{CO2}} / ( K_{\\mathrm{CO2}} + C_{a} )\n"

#: <RELIC_ROOT>/docs/source/public/science/biosphere.md:298
msgid ""
"\n"
"A_{\\mathrm{ATP}} = J_{\\mathrm{DMAPP}} \\cdot \\nu_{\\mathrm{ATP}}; A_{\\mathrm{NADPH}} = J_{\\mathrm{DMAPP}} \\cdot \\nu_{\\mathrm{NADPH}}\n"
msgstr ""
"\n"
"A_{\\mathrm{ATP}} = J_{\\mathrm{DMAPP}} \\cdot \\nu_{\\mathrm{ATP}}; A_{\\mathrm{NADPH}} = J_{\\mathrm{DMAPP}} \\cdot \\nu_{\\mathrm{NADPH}}\n"

