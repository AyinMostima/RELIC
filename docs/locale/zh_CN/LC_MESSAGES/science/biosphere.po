# | msgid "StaticPhenology"
#: <RELIC_ROOT>/docs/source/public/science/biosphere.md:1917
msgid "Static phenology equations:"
msgstr "静态物候方程："

#: <RELIC_ROOT>/docs/source/public/science/biosphere.md:1921
#, python-brace-format
msgid ""
"\n"
"f_{growth}(t) =\n"
"\\begin{cases}\n"
"0 & \\text{if } t < t_{onset} \\\\\n"
"0.5(1 + \\tanh(k(t - t_{onset}))) & \\text{if } t_{onset} \\leq t < t_{full} \\\\\n"
"1 & \\text{if } t_{full} \\leq t < t_{senes} \\\\\n"
"0.5(1 + \\tanh(k(t_{offset} - t))) & \\text{if } t_{senes} \\leq t < t_{offset} \\\\\n"
"0 & \\text{if } t \\geq t_{offset}\n"
"\\end{cases}\n"
msgstr ""
"\n"
"f_{growth}(t) =\n"
"\\begin{cases}\n"
"0 & \\text{if } t < t_{onset} \\\\\n"
"0.5(1 + \\tanh(k(t - t_{onset}))) & \\text{if } t_{onset} \\leq t < t_{full} \\\\\n"
"1 & \\text{if } t_{full} \\leq t < t_{senes} \\\\\n"
"0.5(1 + \\tanh(k(t_{offset} - t))) & \\text{if } t_{senes} \\leq t < t_{offset} \\\\\n"
"0 & \\text{if } t \\geq t_{offset}\n"
"\\end{cases}\n"

#: <RELIC_ROOT>/docs/source/public/science/biosphere.md:1932
#, python-brace-format
msgid ""
"\n"
"LAI(t) = LAI_{max} \\times f_{growth}(t)\n"
msgstr ""
"\n"
"LAI(t) = LAI_{max} \\times f_{growth}(t)\n"

#: <RELIC_ROOT>/docs/source/public/science/biosphere.md:1936
msgid "Where:"
msgstr "其中："

#: <RELIC_ROOT>/docs/source/public/science/biosphere.md:1938
msgid "t: day of year [days]"
msgstr "t：一年中的日序 [days]"

#: <RELIC_ROOT>/docs/source/public/science/biosphere.md:1940
#, python-brace-format
msgid "t_{onset}: leaf onset date [DOY]"
msgstr "t_{onset}：叶片萌发日期 [DOY]"

#: <RELIC_ROOT>/docs/source/public/science/biosphere.md:1942
#, python-brace-format
msgid "t_{offset}: leaf offset date [DOY]"
msgstr "t_{offset}：叶片脱落日期 [DOY]"

#: <RELIC_ROOT>/docs/source/public/science/biosphere.md:1944
#, python-brace-format
msgid "$t_{full} = t_{onset} + expansion_{days}$"
msgstr "$t_{full} = t_{onset} + expansion_{days}$"

#: <RELIC_ROOT>/docs/source/public/science/biosphere.md:1946
#, python-brace-format
msgid "$t_{senes} = t_{offset} - senescence_{days}$"
msgstr "$t_{senes} = t_{offset} - senescence_{days}$"

#: <RELIC_ROOT>/docs/source/public/science/biosphere.md:1948
msgid "$k = \\mathrm{transition}_{\\mathrm{steepness}}$: transition steepness [day-1]"
msgstr "$k = \\mathrm{transition}_{\\mathrm{steepness}}$：转变陡峭度 [day-1]"

