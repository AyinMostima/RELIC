# | msgid "GDDPhenology"
#: <RELIC_ROOT>/docs/source/public/science/biosphere.md:1560
msgid "GDD phenology equations:"
msgstr "GDD 物候方程："

#: <RELIC_ROOT>/docs/source/public/science/biosphere.md:1562
msgid "Daily GDD:"
msgstr "每日 GDD："

#: <RELIC_ROOT>/docs/source/public/science/biosphere.md:1564
msgid ""
"\n"
"GDD_{daily} = \\max(0, \\frac{T_{max} + T_{min}}{2} - T_{base})\n"
msgstr ""
"\n"
"GDD_{daily} = \\max(0, \\frac{T_{max} + T_{min}}{2} - T_{base})\n"

#: <RELIC_ROOT>/docs/source/public/science/biosphere.md:1568
msgid "Cumulative GDD:"
msgstr "累积 GDD："

#: <RELIC_ROOT>/docs/source/public/science/biosphere.md:1570
#, python-brace-format
msgid ""
"\n"
"GDD_{cum} = \\sum_{i=1}^{t} GDD_{daily,i}\n"
msgstr ""
"\n"
"GDD_{cum} = \\sum_{i=1}^{t} GDD_{daily,i}\n"

#: <RELIC_ROOT>/docs/source/public/science/biosphere.md:1574
#: <RELIC_ROOT>/docs/source/public/science/biosphere.md:1919
msgid "Growth factor:"
msgstr "生长因子："

#: <RELIC_ROOT>/docs/source/public/science/biosphere.md:1576
msgid ""
"\n"
"f_{growth}(GDD_{cum}) =\n"
"\\begin{cases}\n"
"0 & \\text{if } GDD_{cum} < GDD_{start} \\\\\n"
"\\frac{GDD_{cum} - GDD_{start}}{GDD_{full} - GDD_{start}} & \\text{if } GDD_{start} \\leq GDD_{cum} < GDD_{full} \\\\\n"
"1 & \\text{if } GDD_{full} \\leq GDD_{cum} < GDD_{end} \\\\\n"
"1 - \\frac{GDD_{cum} - GDD_{end}}{GDD_{senes} - GDD_{end}} & \\text{if } GDD_{end} \\leq GDD_{cum} < GDD_{senes} \\\\\n"
"0 & \\text{if } GDD_{cum} \\geq GDD_{senes}\n"
"\\end{cases}\n"
msgstr ""
"\n"
"f_{growth}(GDD_{cum}) =\n"
"\\begin{cases}\n"
"0 & \\text{if } GDD_{cum} < GDD_{start} \\\\\n"
"\\frac{GDD_{cum} - GDD_{start}}{GDD_{full} - GDD_{start}} & \\text{if } GDD_{start} \\leq GDD_{cum} < GDD_{full} \\\\\n"
"1 & \\text{if } GDD_{full} \\leq GDD_{cum} < GDD_{end} \\\\\n"
"1 - \\frac{GDD_{cum} - GDD_{end}}{GDD_{senes} - GDD_{end}} & \\text{if } GDD_{end} \\leq GDD_{cum} < GDD_{senes} \\\\\n"
"0 & \\text{if } GDD_{cum} \\geq GDD_{senes}\n"
"\\end{cases}\n"

#: <RELIC_ROOT>/docs/source/public/science/biosphere.md:1587
#, python-brace-format
msgid ""
"\n"
"LAI(t) = LAI_{max} \\times f_{growth}(GDD_{cum}(t))\n"
msgstr ""
"\n"
"LAI(t) = LAI_{max} \\times f_{growth}(GDD_{cum}(t))\n"

