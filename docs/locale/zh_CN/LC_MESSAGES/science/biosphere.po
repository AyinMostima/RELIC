# | msgid "CropPhenology"
#: <RELIC_ROOT>/docs/source/public/science/biosphere.md:1322
msgid "Crop phenology equations:"
msgstr "作物物候方程："

#: <RELIC_ROOT>/docs/source/public/science/biosphere.md:1324
msgid "Daily thermal time:"
msgstr "每日热时间："

#: <RELIC_ROOT>/docs/source/public/science/biosphere.md:1326
#, python-brace-format
msgid ""
"\n"
"PHU_{daily} = \\max(0, T_{avg} - T_{base})\n"
msgstr ""
"\n"
"PHU_{daily} = \\max(0, T_{avg} - T_{base})\n"

#: <RELIC_ROOT>/docs/source/public/science/biosphere.md:1330
msgid "Cumulative PHU:"
msgstr "累积 PHU："

#: <RELIC_ROOT>/docs/source/public/science/biosphere.md:1332
#, python-brace-format
msgid ""
"\n"
"PHU_{cum} = \\sum_{i=sowing}^{t} PHU_{daily,i}\n"
msgstr ""
"\n"
"PHU_{cum} = \\sum_{i=sowing}^{t} PHU_{daily,i}\n"

#: <RELIC_ROOT>/docs/source/public/science/biosphere.md:1336
msgid "Development index:"
msgstr "发育指数："

#: <RELIC_ROOT>/docs/source/public/science/biosphere.md:1338
msgid ""
"\n"
"DI = \\frac{PHU_{cum}}{PHU_{total}}\n"
msgstr ""
"\n"
"DI = \\frac{PHU_{cum}}{PHU_{total}}\n"

# | msgid "`harvest_index`"
#: <RELIC_ROOT>/docs/source/public/science/biosphere.md:1342
msgid "Harvest index dynamics:"
msgstr "收获指数动力学："

#: <RELIC_ROOT>/docs/source/public/science/biosphere.md:1344
msgid ""
"\n"
"HI(t) = HI_{max} \\times \\frac{DI - DI_{HI-start}}{1 - DI_{HI-start}}\n"
msgstr ""
"\n"
"HI(t) = HI_{max} \\times \\frac{DI - DI_{HI-start}}{1 - DI_{HI-start}}\n"

#: <RELIC_ROOT>/docs/source/public/science/biosphere.md:1348
#, python-brace-format
msgid ""
"\n"
"\\text{ for } DI \\geq DI_{HI-start}\n"
msgstr ""
"\n"
"\\text{ for } DI \\geq DI_{HI-start}\n"

# | msgid "BiomassAllocation"
#: <RELIC_ROOT>/docs/source/public/science/biosphere.md:1352
msgid "Biomass partitioning:"
msgstr "生物量分配："

#: <RELIC_ROOT>/docs/source/public/science/biosphere.md:1354
#, python-brace-format
msgid ""
"\n"
"f_{grain} = HI(t) \\text{ during grain filling}\n"
msgstr ""
"\n"
"f_{grain} = HI(t) \\text{ during grain filling}\n"

#: <RELIC_ROOT>/docs/source/public/science/biosphere.md:1358
#, python-brace-format
msgid ""
"\n"
"f_{leaf} = (1 - HI(t)) \\times allocation_{leaf}(DI)\n"
msgstr ""
"\n"
"f_{leaf} = (1 - HI(t)) \\times allocation_{leaf}(DI)\n"

#: <RELIC_ROOT>/docs/source/public/science/biosphere.md:1362
#, python-brace-format
msgid ""
"\n"
"f_{stem} = (1 - HI(t)) \\times allocation_{stem}(DI)\n"
msgstr ""
"\n"
"f_{stem} = (1 - HI(t)) \\times allocation_{stem}(DI)\n"

#: <RELIC_ROOT>/docs/source/public/science/biosphere.md:1366
#, python-brace-format
msgid ""
"\n"
"f_{root} = (1 - HI(t)) \\times allocation_{root}(DI)\n"
msgstr ""
"\n"
"f_{root} = (1 - HI(t)) \\times allocation_{root}(DI)\n"

#: <RELIC_ROOT>/docs/source/public/science/biosphere.md:1370
msgid "Development stages:"
msgstr "发育阶段："

#: <RELIC_ROOT>/docs/source/public/science/biosphere.md:1372
#, python-brace-format
msgid "Germination: $0 < \\mathrm{DI} < 0.15$"
msgstr "萌发：$0 < \\mathrm{DI} < 0.15$"

#: <RELIC_ROOT>/docs/source/public/science/biosphere.md:1374
#, python-brace-format
msgid "Vegetative: $0.15 < \\mathrm{DI} < 0.4$"
msgstr "营养生长：$0.15 < \\mathrm{DI} < 0.4$"

#: <RELIC_ROOT>/docs/source/public/science/biosphere.md:1376
#, python-brace-format
msgid "Reproductive: $0.4 < \\mathrm{DI} < 0.65$"
msgstr "生殖生长：$0.4 < \\mathrm{DI} < 0.65$"

#: <RELIC_ROOT>/docs/source/public/science/biosphere.md:1378
#, python-brace-format
msgid "Grain filling: $0.65 < \\mathrm{DI} < 1.0$"
msgstr "籽粒灌浆：$0.65 < \\mathrm{DI} < 1.0$"

#: <RELIC_ROOT>/docs/source/public/science/biosphere.md:1380
msgid "$Maturity: DI \\geq 1.0$"
msgstr "$Maturity: DI \\geq 1.0$（成熟期）"

# | msgid "" "C and N turnover uses x_dot = N_h r_h with explicit
# | stoichiometric_N and " "rates evaluated by advance_reaction_network; crop
# | temporal full states " "use the canonical StateManager replacement path."
#: <RELIC_ROOT>/docs/source/public/science/biosphere.md
#, python-brace-format
msgid "C and N turnover uses $\\dot{x} = N_{h} r_{h}$ with explicit stoichiometric_N and rates evaluated by advance_reaction_network; crop temporal full states use the canonical StateManager replacement path."
msgstr "碳氮周转采用 $\\dot{x} = N_{h} r_{h}$，其中显式 stoichiometric_N 和 rates 由 advance_reaction_network 求值；作物时间完整状态采用规范 StateManager 替换路径。"

#: <RELIC_ROOT>/docs/source/public/science/biosphere.md
msgid "CropPhenology inherits PhenologyBase.forward, which calls advance_reaction_network for the C and N turnover ledger and emits explicit REPLACE updates for the complete crop temporal state."
msgstr "CropPhenology 继承 PhenologyBase.forward；后者针对 C 与 N turnover ledger 调用 advance_reaction_network，并为完整 crop temporal state 发出显式 REPLACE updates。"

# | msgid "" "PhenologyBase.forward materializes stoichiometric_N and rates
# for
# | the C " "and N turnover outputs and lowers x_dot=N_h r_h through "
# | "advance_reaction_network; PHU and crop-cycle memory are not "
# | "misrepresented as reaction states."
#: <RELIC_ROOT>/docs/source/public/science/biosphere.md
#, python-brace-format
msgid "PhenologyBase.forward materializes stoichiometric_N and rates for the C and N turnover outputs and lowers $\\dot{x} = N_{h} r_{h}$ through advance_reaction_network; PHU and crop-cycle memory are not misrepresented as reaction states."
msgstr "PhenologyBase.forward 为碳氮周转输出实体化 stoichiometric_N 和 rates，并通过 advance_reaction_network 将 $\\dot{x} = N_{h} r_{h}$ 下沉到运行时；PHU 和作物周期记忆不被错误表示为反应状态。"

