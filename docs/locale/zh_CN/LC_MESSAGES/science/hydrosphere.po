msgid "Lateral subsurface discharge follows a storage-discharge recession law with an optional catchment-mean TOPMODEL closure $Q_{b} = 1000 \\cdot \\mathrm{T}_{0} \\cdot \\exp ( - \\lambda ) \\cdot \\exp ( - S_{\\mathrm{def}} / m ) \\cdot f_{\\theta} ( \\mathrm{Beven} \\mathrm{and} \\mathrm{Kirkby} , 1979 )$ and a moisture-gated interflow drainage $Q_{i} = k_{i} \\cdot c_{i} \\cdot \\max ( 0 , \\theta - \\theta_{t} ) ^ n \\cdot S \\mathrm{of} \\mathrm{the} \\mathrm{same} \\mathrm{store} .$"
msgstr "侧向地下排泄遵循储量-流量退水律，并带有可选的流域平均 TOPMODEL 闭合 $Q_{b} = 1000 \\cdot \\mathrm{T}_{0} \\cdot \\exp ( - \\lambda ) \\cdot \\exp ( - S_{\\mathrm{def}} / m ) \\cdot f_{\\theta} ( \\mathrm{Beven} \\mathrm{and} \\mathrm{Kirkby} , 1979 )$ 以及受湿度门控的壤中流排水 $Q_{i} = k_{i} \\cdot c_{i} \\cdot \\max ( 0 , \\theta - \\theta_{t} ) ^ n \\cdot S \\mathrm{of} \\mathrm{the} \\mathrm{same} \\mathrm{store} .$"

#: <RELIC_ROOT>/docs/source/public/science/hydrosphere.md:541
msgid ""
"\n"
"\\dot{S} = I_{\\mathrm{drain}} - D_{h} q_{\\mathrm{total}}; q_{\\mathrm{total}} = \\star_{T} g_{h} + q_{\\mathrm{interflow}} + q_{\\mathrm{capacity}}; \\star_{T} \\geq 0 .\n"
msgstr ""
"\n"
"\\dot{S} = I_{\\mathrm{drain}} - D_{h} q_{\\mathrm{total}}; q_{\\mathrm{total}} = \\star_{T} g_{h} + q_{\\mathrm{interflow}} + q_{\\mathrm{capacity}}; \\star_{T} \\geq 0 .\n"

