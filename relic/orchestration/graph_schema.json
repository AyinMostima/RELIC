{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RELIC Graph IR",
  "type": "object",
  "definitions": {
    "assertion_item": {
      "type": "object",
      "required": ["phi", "op", "scope"],
      "properties": {
        "phi": { "type": "string", "minLength": 1 },
        "op": { "type": "string", "minLength": 1 },
        "scope": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "object", "minProperties": 1 }
          ]
        },
        "context": { "type": "object" },
        "metadata": { "type": "object" },
        "audit_key": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  },
  "required": ["schema_version", "nodes"],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["class_type"],
        "properties": {
          "class_type": { "type": "string" },
          "inputs": { "type": "object" },
          "outputs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "config": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": {
            "type": "object",
            "required": ["node", "port"],
            "properties": {
              "node": { "type": "string" },
              "port": { "type": "string" }
            },
            "additionalProperties": false
          },
          "to": {
            "type": "object",
            "required": ["node", "port"],
            "properties": {
              "node": { "type": "string" },
              "port": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": "object"
    },
    "assertion": {
      "anyOf": [
        { "$ref": "#/definitions/assertion_item" },
        {
          "type": "object",
          "required": ["assertions"],
          "properties": {
            "assertions": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/definitions/assertion_item" }
            },
            "metadata": { "type": "object" }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
